# ═══════════════════════════════════════════════════
# DevHawk App — Environment Variables
# Copy to .env.local for local development
# ═══════════════════════════════════════════════════

# ── Database (DO Managed PostgreSQL 16) ──
DATABASE_URL="postgresql://devhawk:devhawk_local@localhost:5432/devhawk"

# ── Redis (DO Managed Redis 7 — BullMQ + cache) ──
REDIS_URL="redis://localhost:6379"

# ── Better Auth ──
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# ── Public (exposed to browser) ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── AI Providers (at least one recommended) ──
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# ── Stripe (optional until payments needed) ──
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ── Resend (optional until email needed) ──
# RESEND_API_KEY=""

# ── Superadmin Bootstrap (one-time setup after first deploy) ──
# Generate: openssl rand -hex 32
# Used by POST /api/bootstrap to create the first org owner.
# See docs/deployment.md → "First deploy" for the curl command.
# SUPERADMIN_SETUP_TOKEN=""

# ── Social Login (uncomment per project) ──
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
