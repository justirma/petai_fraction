{
  "name": "devhawk-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f docker/docker-compose.dev.yml up -d && pm2 start ecosystem.config.cjs && pm2 logs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint && biome check .",
    "lint:fix": "next lint --fix && biome check --write .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:pull": "drizzle-kit pull",
    "db:seed": "tsx lib/db/seed.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "worker": "tsx lib/jobs/worker.ts",
    "worker:dev": "tsx watch lib/jobs/worker.ts",
    "dev:all": "pnpm dev",
    "dev:stop": "pm2 stop all",
    "dev:logs": "pm2 logs",
    "dev:status": "pm2 status"
  },
  "dependencies": {
    "next": "^16.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",

    "better-auth": "^1.5.6",

    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.8.0",
    "postgres": "^3.4.0",

    "bullmq": "^5.40.0",
    "ioredis": "5.9.3",

    "ai": "^6.0.138",
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/openai": "^3.0.48",

    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0",
    "lucide-react": "^0.500.0",

    "zod": "^3.24.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.70.0",

    "stripe": "^18.0.0",
    "resend": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",

    "drizzle-kit": "^0.31.4",

    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",

    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.0",
    "@biomejs/biome": "^1.9.0",

    "vitest": "^3.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "@playwright/test": "^1.50.0",

    "pm2": "^6.0.0",
    "tsx": "^4.19.0",
    "postcss": "^8.5.0"
  }
}
